# Copy this file to .env and fill in what you need. Never commit .env (it holds secrets).

# ---- Gen AI model: set ONE key ----------------------------------------------
# Claude (paid, pay-as-you-go): https://console.anthropic.com
ANTHROPIC_API_KEY=
# Gemini (has a small free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# auto = Claude if its key is set, else Gemini, else demo mode (sample replies)
AI_PROVIDER=auto
CLAUDE_MODEL=claude-sonnet-5-5
# Cheaper Claude option: claude-haiku-5-5
GEMINI_MODEL=gemini-3.8-flash

# Let the AI search the web for current answers with sources (extra cost; for
# Gemini it needs a paid key)
WEB_SEARCH=false

# Optional extra instructions added to the AI's system prompt
SYSTEM_PROMPT=

# ---- Database ------------------------------------------------------------------
# Empty = local SQLite file (chat.db), fine on your own computer.
# In the cloud, use PostgreSQL so data survives restarts, for example:
# DATABASE_URL=postgresql://user:password@host:5432/nimbus?sslmode=require
DATABASE_URL=

# ---- App ---------------------------------------------------------------------
APP_NAME=Nimbus
ALLOW_SIGNUPS=true
# Max messages per user per 10 minutes (protects your API bill)
CHAT_LIMIT_PER_10_MIN=30
